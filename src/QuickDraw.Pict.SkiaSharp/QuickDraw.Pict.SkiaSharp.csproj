<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>QuickDraw.Pict.SkiaSharp</PackageId>
    <Description>SkiaSharp integration for QuickDraw.Pict: decode Apple QuickDraw PICT pictures, QuickTime image files (QTIF) and MacPaint documents to SKBitmap/SKImage with QuickDraw.Pict's Macintosh-exact engine (JPEG/PNG/GIF/WebP/BMP QuickTime images through Skia's codecs, outline-font text through Skia when no bitmap font is supplied), and encode SKBitmap/SKPixmap as PICT (indexed, 16-bit, 32-bit with alpha, resolution, ICC).</Description>
    <PackageTags>skiasharp;skia;pict;quickdraw;macintosh;image;decoder;encoder</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickDraw.Pict\QuickDraw.Pict.csproj" />
  </ItemGroup>

</Project>
