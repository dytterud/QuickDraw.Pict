<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>QuickDraw.Pict.ImageSharp</PackageId>
    <Description>SixLabors.ImageSharp format plugin for Apple QuickDraw PICT pictures, QuickTime image files (QTIF) and MacPaint documents: detection, Macintosh-exact decoding with QuickDraw.Pict (JPEG/PNG/GIF/TIFF/WebP/BMP QuickTime images through ImageSharp, outline-font text through SixLabors.Fonts when no bitmap font is supplied) and PICT encoding (indexed, 16-bit, 32-bit with alpha, resolution, ICC).</Description>
    <PackageTags>imagesharp;pict;quickdraw;macintosh;image;decoder;encoder</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuickDraw.Pict\QuickDraw.Pict.csproj" />
  </ItemGroup>

</Project>
